# Copy this file to .env and fill in at least ONE free AI key.
# If you set several, they're all used as a fallback chain: Groq -> custom -> Gemini.
# If every AI is down, the buddy still talks using scripted lines built from species facts.

# ---- Recommended (FREE, fast, ~1,000 requests/day per model): Groq ----
# Key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ---- Also free: Google Gemini (small daily quota, often "high demand") ----
# Key at https://aistudio.google.com/apikey. Also powers the free natural voice (Gemini TTS).
GEMINI_API_KEY=
# GEMINI_TTS_VOICE=Leda

# ---- Free + offline: Ollama on your own PC. https://ollama.com ----
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---- Paid: Claude ----
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic

# Optional premium voice (ElevenLabs). Without it: Gemini voice, then the browser voice.
# ELEVENLABS_API_KEY=
